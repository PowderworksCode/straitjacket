{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/instructions.sh\" 2>/dev/null",
            "statusMessage": "Loading straitjacket policy"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/instructions.sh\" 2>/dev/null",
            "statusMessage": "Loading straitjacket policy"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/instructions.sh\" 2>/dev/null",
            "statusMessage": "Loading straitjacket policy"
          }
        ]
      }
    ]
  }
}

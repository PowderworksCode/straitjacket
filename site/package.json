{
  "name": "straitjacket-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "cp ../install.sh public/install && rm -rf out && powderworks-docs build content --out out --site straitjacket --static public",
    "social": "python3 node_modules/powderworks-docs/tools/social-card.py --site straitjacket",
    "social:check": "python3 node_modules/powderworks-docs/tools/social-card.py --site straitjacket --check",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "bun test"
  },
  "dependencies": {
    "powderworks-docs": "github:PowderworksCode/docs"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
